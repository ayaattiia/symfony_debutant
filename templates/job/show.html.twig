
{% extends 'base.html.twig' %}

{% block title %}Détails du Job{% endblock %}

{% block body %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4" style="max-width:700px;">

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3>Détails du Job N° {{ job.id }}</h3>
        </div>

        <div class="card-body">
            <p><strong>Type :</strong> {{ job.type }}</p>
            <p><strong>Entreprise :</strong> {{ job.company }}</p>
            <p><strong>Description :</strong> {{ job.discription }}</p>
            <p><strong>Email :</strong> {{ job.email }}</p>
            <p><strong>Expiration :</strong>
                {{ job.expiresAt|date('d/m/Y') }}
            </p>

            {% if job.image is not null %}
                <img src="{{ job.image.url }}"
                     alt="{{ job.image.alt }}"
                     class="img-fluid rounded"
                     style="max-height:200px;">
            {% endif %}
        </div>

        <div class="card-footer">
            <a href="{{ path('job_index') }}"
               class="btn btn-secondary">
                Retour
            </a>

            <a href="{{ path('job_edit', {'id': job.id}) }}"
               class="btn btn-warning">
                Modifier
            </a>
        </div>
    </div>
</div>
{% endblock %}
