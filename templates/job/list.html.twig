
{% extends 'base.html.twig' %}

{% block title %}Liste des Jobs{% endblock %}

{% block body %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">

    <h2 class="text-center mb-4">Liste des Jobs</h2>

    <a href="{{ path('job_new') }}" class="btn btn-primary mb-3">
        + Ajouter un Job
    </a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Entreprise</th>
                <th>Type</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {% for job in jobs %}
                <tr>
                    <td>{{ job.id }}</td>
                    <td>{{ job.company }}</td>
                    <td>{{ job.type }}</td>
                    <td>{{ job.email }}</td>
                    <td>
                        <a href="{{ path('job_show', {'id': job.id}) }}"
                           class="btn btn-info btn-sm">
                            Voir
                        </a>

                        <a href="{{ path('job_edit', {'id': job.id}) }}"
                           class="btn btn-warning btn-sm">
                            Modifier
                        </a>

                        <form method="post"
                              action="{{ path('job_delete', {'id': job.id}) }}"
                              style="display:inline"
                              onsubmit="return confirm('Supprimer ce Job ?');">

                            <input type="hidden"
                                   name="_token"
                                   value="{{ csrf_token('delete' ~ job.id) }}">

                            <button class="btn btn-danger btn-sm">
                                Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">
                        Aucun job trouvé.
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
